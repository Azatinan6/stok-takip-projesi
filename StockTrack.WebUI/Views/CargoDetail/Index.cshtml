@using StockTrack.Dto.CargoDetail
@using StockTrack.WebUI.Enums
@model List<StockTrack.Dto.CargoDetail.ResultAwitingApprovalDto>

@{
    ViewData["Title"] = "Tüm Kargolar";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@await Component.InvokeAsync("GlobalFilterBar")

<div class="d-flex flex-wrap gap-3 mb-4">
    <a href="~/CargoDetail/Index" class="btn rounded-pill fw-bold px-3 py-1 me-2 mb-2 shadow-sm"
       style="background-color: #f1f3f5; color: #495057;">Tümü (@ViewBag.AllCount)</a>
    <a href="~/CargoDetail/AwaitingApproval" class="btn rounded-pill fw-bold px-3 py-1 me-2 mb-2 shadow-sm"
       style="background-color: #fde2e1; color: #d62828; border: 1px solid #f5c2c0;">Onay Bekliyor
        (@ViewBag.PendingCount)</a>
        <a href="~/CargoDetail/ReadyForCargo" class="btn rounded-pill fw-bold px-3 py-1 me-2 mb-2 shadow-sm"
           style="background-color: #fff4cc; color: #e0a800; border: 1px solid #ffe69c;">Paketlendi
            (@ViewBag.PackagedCount)</a>
            <a href="~/CargoDetail/CargoInDelivery" class="btn rounded-pill fw-bold px-3 py-1 me-2 mb-2 shadow-sm"
               style="background-color: #d0ebff; color: #1971c2; border: 1px solid #a5d8ff;">Kargoda
                (@ViewBag.InCargoCount)</a>
                <a href="~/CargoDetail/Delivered" class="btn rounded-pill fw-bold px-3 py-1 me-2 mb-2 shadow-sm"
                   style="background-color: #d3f9d8; color: #2b8a3e; border: 1px solid #b2f2bb;">Teslim Edildi
                    (@ViewBag.DeliveredCount)</a>
                    <a href="~/CargoDetail/Cancelled" class="btn rounded-pill fw-bold px-3 py-1 me-2 mb-2 shadow-sm"
                       style="background-color: #ffe3e3; color: #c92a2a; border: 1px solid #ffc9c9;">İptal Edilenler
                        (@ViewBag.CancelledCount)</a>

                        <a href="~/CargoDetail/OfficePickup" class="btn rounded-pill fw-bold px-3 py-1 me-2 mb-2 shadow-sm"
                           style="background-color: #e0f7fa; color: #00838f; border: 1px solid #b2ebf2;">Ofisten Teslim
                            (@ViewBag.OfficePickupCount)</a>
                            <a href="~/CargoDetail/ReturnWaiting" class="btn rounded-pill fw-bold px-3 py-1 me-2 mb-2 shadow-sm"
                               style="background-color: #f4ecfb; color: #6f42c1; border: 1px solid #d6c3eb;">İade Geldiği Zaman Kargoya
                                Verilecek (@ViewBag.ReturnWaitingCount)</a>
                                <a href="~/CargoDetail/Deleted" class="btn rounded-pill fw-bold px-3 py-1 me-2 mb-2 shadow-sm"
                                   style="background-color: #e9ecef; color: #6c757d; border: 1px solid #dee2e6;">Silinenler
                                    (@ViewBag.DeletedCount)</a>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-3 mb-2">
                                    <h4>Tüm Kargolar</h4>
                                    <div class="text-start mb-3">
                                        <a href="@Url.Action("ReturnsIndex", "CargoDetail")" class="btn btn-outline-success shadow-sm"><i
                                            class="mdi mdi-check"></i> İade Yönetim Paneline Git</a>
                                        </div>
                                    </div>
                                    <hr />

                                    @if (TempData["SuccessMessage"] != null)
                                    {
                                        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                                            <i class="mdi mdi-check-circle me-1"></i> @TempData["SuccessMessage"]
                                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                                        </div>
                                    }
                                    @if (TempData["ErrorMessage"] != null)
                                    {
                                        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                                            <i class="mdi mdi-alert-circle me-1"></i> @TempData["ErrorMessage"]
                                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                                        </div>
                                    }

                                    <div class="row mb-3">
                                        <div class="col-md-4">
                                            <div class="input-group shadow-sm">
                                                <span class="input-group-text bg-white border-end-0"><i class="mdi mdi-magnify text-muted"></i></span>
                                                <input type="text" id="customRequesterSearch" class="form-control border-start-0"
                                                       placeholder="Talep Açan Kişiye Göre Filtrele...">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="card shadow mb-4 border-0">
                                        <div class="card-body p-0">
                                            <div class="table-responsive">
                                                <table class="table table-hover table-striped align-middle mb-0" id="cargoTable">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>ID</th>
                                                            <th>Durum</th>
                                                            <th>Tarih</th>
                                                            <th>Talep Açan Kişi</th>
                                                            <th>Depo</th>
                                                            <th>Ürün (Miktar)</th>
                                                            <th>Hastane</th>
                                                            <th>Şube</th>
                                                            <th>Kargo Verilme Tarihi</th>
                                                            <th>Kargo Hazırlayan Kişi</th>
                                                            <th>Kargo Takip No</th>
                                                            <th class="text-center">İşlemler</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var item in Model)
                                                        {
                                                            // ZIRH: Eğer statü İade Süreçlerinden biriyse (20 ve üzeri), bunu Gönderim Ekranında GİZLE!
                                                            if (item.StatusId >= 20) continue;

                                                            <tr>
                                                                <td>@item.Id</td>
                                                                <td>
                                                                    @{
                                                                        string badgeColor = "bg-secondary";
                                                                        if (item.StatusId == (int)EnumStatusType.OnayBekliyor) badgeColor = "bg-danger";
                                                                        else if (item.StatusId == (int)EnumStatusType.Paketlendi) badgeColor = "bg-warning text-dark";
                                                                        else if (item.StatusId == (int)EnumStatusType.Kargoda) badgeColor = "bg-info text-dark";
                                                                        else if (item.StatusId == (int)EnumStatusType.Tamamlandı) badgeColor = "bg-success";
                                                                        else if (item.StatusId == (int)EnumStatusType.İptal) badgeColor = "bg-danger fw-bold";
                                                                        else if (item.StatusId == 11) badgeColor = "bg-info-subtle text-info border border-info";
                                                                        else if (item.StatusId == 13) badgeColor = "bg-dark bg-gradient";
                                                                    }
                                                                    <span class="badge @badgeColor">
                                                                        @item.StatusName
                                                                    </span>
                                                                </td>
                                                                <td>@(item.RequestFormRequestedDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                                                                <td class="fw-bold text-primary">@(item.RequestFormRequestedBy ?? "-")</td>
                                                                <td>@item.MainRepoName</td>
                                                                <td>
                                                                    @foreach (var product in item.Products)
                                                                    {
                                                                        <div>@product.ProductName <small class="text-muted">(@product.Quantity Adet)</small></div>
                                                                    }
                                                                </td>
                                                                <td>
                                                                    @if (item.IsOfficeDelivery)
                                                                    {
                                                                        <span class="badge bg-info-subtle text-info border border-info mt-1"
                                                                              style="font-size: 0.75rem;"><i class="mdi mdi-office-building"></i> Ofisten
                                                                            Teslim</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="fw-bold">@item.HospitalName</div>
                                                                    }

                                                                    @if (item.StatusId == 13)
                                                                    {
                                                                        <span class="badge bg-warning-subtle text-warning border border-warning mt-1 d-block w-auto"
                                                                              style="font-size: 0.70rem;">
                                                                            <i class="mdi mdi-keyboard-return"></i> İade Gelince Kargolanacak
                                                                        </span>
                                                                    }
                                                                </td>

                                                                <td>@(item.BranchName ?? "-")</td>

                                                                <td>@(item.CargoGivenDate?.ToString("dd.MM.yyyy") ?? "-")</td>

                                                                <td><span class="badge bg-light text-dark border">@(string.IsNullOrEmpty(item.CargoProccessBy) ?
                                                                          "Atanmadı" : item.CargoProccessBy)</span></td>

                                                                <td>
                                                                    @if (item.IsOfficeDelivery && (item.StatusId == (int)EnumStatusType.Kargoda || item.StatusId
                                                                    == (int)EnumStatusType.Tamamlandı))
                                                                    {
                                                                        <span class="badge bg-secondary">Ofisten Teslim</span>
                                                                    }
                                                                    else if (string.IsNullOrEmpty(item.TrackingNumber) && (item.StatusId ==
                                                                    (int)EnumStatusType.Kargoda || item.StatusId == (int)EnumStatusType.Tamamlandı))
                                                                    {
                                                                        <span class="text-danger fw-bold"><i class="mdi mdi-alert-circle"></i> Eksik!</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        @(string.IsNullOrEmpty(item.TrackingNumber) ? "-" : item.TrackingNumber)
                                                                    }
                                                                </td>
                                                                <td class="text-center">
                                                                    <button type="button" class="btn btn-sm btn-primary change-status-btn"
                                                                            style="white-space:nowrap !important;" data-bs-toggle="modal"
                                                                            data-bs-target="#cargoStatusModal" data-cargodetailid="@item.Id"
                                                                            data-location="@item.HospitalName"
                                                                            data-isoffice="@(item.IsOfficeDelivery ? "true" : "false")"
                                                                            data-category="@(item.Products.Any() ? string.Join(", ", item.Products.Select(p => p.CategoryName)) : "-")"
                                                                            data-product="@(item.Products.Any() ? string.Join(", ", item.Products.Select(p => p.ProductName)) : "-")"
                                                                            data-quantity="@(item.Products.Any() ? string.Join(", ", item.Products.Select(p => p.Quantity)) : "-")"
                                                                            data-receiver="@item.ReceiverFullName" data-address="@item.HospitalAddress"
                                                                            data-username="@item.RequestFormRequestedBy" data-tracking="@item.TrackingNumber"
                                                                            data-preparer="@item.CargoProccessBy" data-company="@item.CargoNameId"
                                                                            data-label="@item.Label" data-sendreason="@item.SendReason"
                                                                            data-condition="@item.ProductCondition" data-note="@item.Note"
                                                                            data-serial="@item.SerialNumber" data-ethmac="@item.EthMac" data-wlanmac="@item.WlanMac"
                                                                            data-connection="@item.ConnectionType" data-configurl="@item.ConfigUrl">
                                                                        <i class="mdi mdi-cog"></i> İşlem Yap
                                                                    </button>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="modal fade" id="cargoStatusModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
                                        <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
                                            <div class="modal-content border-top border-primary border-4">
                                                <form id="cargoOperasyonForm" asp-action="SaveCargoInfo" method="post" novalidate>
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="Id" id="cargoDetailId" />

                                                    <div class="modal-header bg-light border-bottom-0 pb-0">
                                                        <h5 class="modal-title text-primary fw-bold"><i class="mdi mdi-truck-delivery-outline"></i> Teslimat
                                                            İşlem Merkezi</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                                                        </div>

                                                        <div class="modal-body p-4">
                                                            <div class="row">
                                                                <div class="col-lg-6 border-end pe-4">
                                                                    <h6 class="text-uppercase text-muted mb-3 border-bottom pb-2">1. Gönderim Detayı</h6>
                                                                    <table class="table table-sm table-borderless mb-0">
                                                                        <tbody>
                                                                            <tr>
                                                                                <td class="text-muted" style="width: 140px;">Teslim Türü:</td>
                                                                                <td class="fw-bold text-dark" id="summaryDeliveryType">-</td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td class="text-muted">Ürün:</td>
                                                                                <td class="fw-bold text-primary" id="summaryProduct">-</td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td class="text-muted">Kategori:</td>
                                                                                <td class="fw-bold" id="summaryCategory">-</td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td class="text-muted">Miktar:</td>
                                                                                <td class="fw-bold" id="summaryQuantity">-</td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td class="text-muted">Etiket / Seri No:</td>
                                                                                <td class="fw-bold" id="summaryLabel">-</td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td class="text-muted">Gönderim Nedeni:</td>
                                                                                <td class="fw-bold" id="summarySendReason">-</td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td class="text-muted align-top">Adres / Not:</td>
                                                                                <td class="fw-bold small fst-italic text-wrap text-muted" id="summaryNote">-
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>

                                                                    <div id="arcBoxPanel" class="mt-3 p-3 border border-warning rounded d-none"
                                                                         style="background-color: #fffdf2;">
                                                                        <h6 class="text-warning-emphasis fw-bold border-bottom border-warning pb-2 mb-2">
                                                                            <i class="mdi mdi-router-wireless"></i> Arc Box Config Bilgileri
                                                                        </h6>
                                                                        <ul class="list-unstyled small mb-0 text-dark">
                                                                            <li class="mb-1"><b>Bağlantı Türü:</b> <span id="cfgConnection">-</span></li>
                                                                            <li class="mb-1"><b>ETH MAC:</b> <span id="cfgEth"
                                                                                                                       class="font-monospace text-primary">-</span></li>
                                                                                <li class="mb-1"><b>WLAN MAC:</b> <span id="cfgWlan"
                                                                                                                            class="font-monospace text-primary">-</span></li>
                                                                                    <li class="mb-1"><b>Seri No:</b> <span id="cfgSerial"
                                                                                                                               class="font-monospace">-</span></li>
                                                                                        <li class="mt-2">
                                                                                            <b>Config URL:</b><br>
                                                                                            <a href="#" id="cfgUrl" target="_blank"
                                                                                               class="text-break text-decoration-none fw-bold">-</a>
                                                                                        </li>
                                                                                    </ul>
                                                                                </div>
                                                                            </div>

                                                                            <div class="col-lg-6 ps-4">
                                                                                <h6 class="text-uppercase text-muted mb-3 border-bottom pb-2">2. Kargo Durum Güncelle</h6>

                                                                                <div class="mb-3 bg-white">
                                                                                    <label class="form-label fw-bold text-dark mb-1">Talep Açan Kişi</label>
                                                                                    <input type="text" id="modalRequesterName" class="form-control bg-light" readonly />
                                                                                </div>

                                                                                <div class="mb-3 bg-light p-2 rounded border border-light">
                                                                                    <label class="form-label fw-bold text-dark mb-1"><i
                                                                                        class="mdi mdi-account-hard-hat"></i> Kargo Hazırlayan <span
                                                                                        class="text-danger">*</span></label>
                                                                                        <select name="CargoPreparerUserId" id="cargoPreparer"
                                                                                                class="form-select border-secondary" asp-items="@(ViewBag.UserNames)">
                                                                                            <option value="">-- Personel Seçiniz --</option>
                                                                                        </select>
                                                                                    </div>

                                                                                    <div class="d-flex flex-column mb-3">
                                                                                        <label class="col-form-label fw-bold">Durumu <span class="text-danger">*</span></label>
                                                                                        <select name="StatusId" id="cargoStatusSelect" class="form-select border-primary">
                                                                                            <option value="">-- Durum Seçiniz --</option>
                                                                                            <option value="@((int)EnumStatusType.OnayBekliyor)">Onay Bekliyor</option>
                                                                                            <option value="@((int)EnumStatusType.Paketlendi)">Paketlendi - Kargoya Hazır
                                                                                            </option>
                                                                                            <option value="11">Ofisten Teslim Alınacak</option>
                                                                                            <option value="13">İade Geldiği Zaman Kargolanacak</option>
                                                                                            <option value="@((int)EnumStatusType.Kargoda)">Kargoya Verildi</option>
                                                                                            <option value="@((int)EnumStatusType.Tamamlandı)">Teslim Edildi</option>
                                                                                            <option value="@((int)EnumStatusType.İptal)">İptal Edildi</option>
                                                                                        </select>
                                                                                    </div>

                                                                                    <div id="cargoExtraFields" class="row g-3 d-none bg-light p-2 rounded border mt-1">
                                                                                        <div class="mb-3">
                                                                                            <label class="form-label fw-bold">Kargo Firması</label>
                                                                                            <select name="CargoNameId" id="cargoCompanySelect"
                                                                                                    class="form-select border-primary" asp-items="@ViewBag.CargoNames"></select>
                                                                                        </div>
                                                                                        <div class="col-12">
                                                                                            <label class="form-label mb-1">Kargo Takip Numarası</label>
                                                                                            <input type="text" name="TrackingNumber" id="trackingNumber"
                                                                                                   class="form-control w-100" placeholder="Varsa giriniz..." />
                                                                                        </div>
                                                                                    </div>

                                                                                    <div id="cancelReasonField" class="row mt-3 d-none">
                                                                                        <div class="col-12">
                                                                                            <label class="form-label text-danger fw-bold mb-1">İptal Sebebi <span
                                                                                                class="text-danger">*</span></label>
                                                                                                <textarea name="CancelDescription" id="cancelReason"
                                                                                                          class="form-control border-danger w-100" rows="2"></textarea>
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>

                                                                            <div class="modal-footer bg-light">
                                                                                <a href="javascript:void(0);" id="btnExportPdf" target="_blank" class="btn btn-outline-danger d-none me-auto">
                                                                                    <i class="mdi mdi-file-pdf-box"></i> Cihaz Çıkış Formu (PDF)
                                                                                </a>

                                                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                                                                                <button type="button" id="btnSaveCargo" class="btn btn-success px-5">
                                                                                    <i class="mdi mdi-content-save-check"></i> Kaydet ve Güncelle
                                                                                </button>
                                                                            </div>
                                                                            </form>
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                @section Scripts {
                                                                    <script>
                                                                        const ST_KARGODA = @((int)EnumStatusType.Kargoda);
                                                                        const ST_TAMAMLANDI = @((int)EnumStatusType.Tamamlandı);
                                                                        const ST_IPTALEDILDI = @((int)EnumStatusType.İptal);

                                                                        let tempTracking = "";
                                                                        let tempCompany = "";

                                                                        $(document).ready(function () {
                                                                            var table = $('#cargoTable').DataTable({
                                                                                "pageLength": 10,
                                                                                "lengthChange": false,
                                                                                "ordering": true,
                                                                                "info": true,
                                                                                "language": {
                                                                                    "emptyTable": "Tabloda herhangi bir veri mevcut değil",
                                                                                    "info": "_TOTAL_ kayıttan _START_ - _END_ arasındaki kayıtlar gösteriliyor",
                                                                                    "infoEmpty": "Kayıt yok",
                                                                                    "infoFiltered": "(_MAX_ kayıt içerisinden bulunan)",
                                                                                    "lengthMenu": "Sayfada _MENU_ kayıt göster",
                                                                                    "loadingRecords": "Yükleniyor...",
                                                                                    "processing": "İşleniyor...",
                                                                                    "search": "Ara:",
                                                                                    "zeroRecords": "Eşleşen kayıt bulunamadı",
                                                                                    "paginate": { "first": "İlk", "last": "Son", "next": "Sonraki", "previous": "Önceki" }
                                                                                }
                                                                            });

                                                                            $('#customRequesterSearch').on('keyup', function () {
                                                                                table.column(3).search(this.value).draw();
                                                                            });
                                                                        });

                                                                        function syncRequired() {
                                                                            const st = parseInt($("#cargoStatusSelect").val() || 0, 10);
                                                                            const needCargo = (st === ST_KARGODA || st === ST_TAMAMLANDI);
                                                                            const needCancel = (st === ST_IPTALEDILDI);

                                                                            $("#cargoExtraFields").toggleClass("d-none", !needCargo);

                                                                            if (needCargo) {
                                                                                $("#trackingNumber").val(tempTracking);
                                                                                $("#cargoCompanySelect").val(tempCompany);
                                                                            } else {
                                                                                $("#trackingNumber").val("");
                                                                                $("#cargoCompanySelect").val("");
                                                                            }

                                                                            $("#cancelReasonField").toggleClass("d-none", !needCancel);
                                                                            if (!needCancel) { $("#cancelReason").val(""); }
                                                                        }

                                                                        $("#cargoStatusSelect").on("change", syncRequired);

                                                                        $("#btnSaveCargo").on("click", function () {
                                                                            const st = parseInt($("#cargoStatusSelect").val() || 0, 10);
                                                                            const company = $("#cargoCompanySelect").val();
                                                                            const cancelReason = $("#cancelReason").val()?.trim() || "";
                                                                            const preparer = $("#cargoPreparer").val();

                                                                            if (st === 0 || isNaN(st)) {
                                                                                Swal.fire('Eksik Bilgi', 'Lütfen Kargo Durumunu seçiniz.', 'warning');
                                                                                return;
                                                                            }
                                                                            if (st !== ST_IPTALEDILDI && !preparer) {
                                                                                Swal.fire('Eksik Bilgi', 'Lütfen Kargoyu Hazırlayan personeli seçiniz.', 'warning');
                                                                                return;
                                                                            }
                                                                            if (st === ST_IPTALEDILDI && !cancelReason) {
                                                                                Swal.fire('Eksik Bilgi', 'İptal durumunda İptal Sebebi zorunludur!', 'warning');
                                                                                return;
                                                                            }

                                                                            $("#cargoOperasyonForm")[0].submit();
                                                                        });

                                                                        $(document).on("click", ".change-status-btn", function () {
                                                                            const d = $(this).data();

                                                                            tempTracking = d.tracking || "";
                                                                            tempCompany = d.company || "";

                                                                            $("#cargoDetailId").val(d.cargodetailid || "");

                                                                            if (d.isoffice === true || d.isoffice === "true" || d.isoffice === "True") {
                                                                                $("#summaryDeliveryType").html('<span class="badge bg-info">Ofisten Teslim</span>');
                                                                            } else {
                                                                                $("#summaryDeliveryType").html('<span class="badge bg-secondary">Adrese Teslim</span>');
                                                                            }

                                                                            $("#summaryCategory").text(d.category || "-");
                                                                            $("#summaryQuantity").text(d.quantity || "-");
                                                                            $("#summaryLabel").text(d.label || "-");
                                                                            $("#summarySendReason").text(d.sendreason || "-");

                                                                            let addressHtml = d.address && d.address !== "-" ? `<b>Adres:</b> ${d.address}<br>` : "";
                                                                            let noteHtml = d.note && d.note !== "-" ? `<b>Not:</b> ${d.note}` : "";
                                                                            $("#summaryNote").html(addressHtml + noteHtml || "-");

                                                                            $("#modalRequesterName").val(d.username || "-");
                                                                            $("#cargoPreparer").val(d.preparer || "");

                                                                            let productName = d.product || "-";
                                                                            $("#summaryProduct").text(productName);

                                                                            // SADECE ARC BOX'TA PDF BUTONU GÖSTER
                                                                            let productNameClean = (d.product || "").replace(/[\s\-]+/g, '').toLowerCase();
                                                                            if (productNameClean.includes("arcbox")) {
                                                                                $("#btnExportPdf").removeClass("d-none").attr("href", "/CargoDetail/ExportDeviceDeliveryPdf?id=" + (d.cargodetailid || 0));
                                                                            } else {
                                                                                $("#btnExportPdf").addClass("d-none").attr("href", "javascript:void(0);");
                                                                            }

                                                                            let pNameClean = productName.replace(/[\s\-]+/g, '').toLowerCase();
                                                                            if (pNameClean.includes("arcbox")) {
                                                                                $("#arcBoxPanel").removeClass("d-none");
                                                                                $("#cfgConnection").text(d.connection || 'Belirtilmedi');
                                                                                $("#cfgEth").text(d.ethmac || '-');
                                                                                $("#cfgWlan").text(d.wlanmac || '-');
                                                                                $("#cfgSerial").text(d.serial || 'Bekleniyor...');

                                                                                if (d.configurl) {
                                                                                    $("#cfgUrl").text(d.configurl).attr("href", d.configurl);
                                                                                } else {
                                                                                    $("#cfgUrl").text('URL Oluşturulmadı').attr("href", "#");
                                                                                }
                                                                            } else {
                                                                                $("#arcBoxPanel").addClass("d-none");
                                                                            }

                                                                            $("#cargoStatusSelect").val("").trigger("change");
                                                                            $("#trackingNumber, #cancelReason").val("");

                                                                            const defaultCargoId = '@ViewBag.DefaultCargoId';
                                                                            if (defaultCargoId) {
                                                                                $("#cargoCompanySelect").val(defaultCargoId);
                                                                            } else {
                                                                                $("#cargoCompanySelect").val("");
                                                                            }

                                                                            if (typeof syncRequired === "function") syncRequired();
                                                                        });
                                                                    </script>
                                                                }