@using StockTrack.Dto.CargoDetail
@using StockTrack.WebUI.Enums
@model List<ResultAwitingApprovalDto>
@{
    ViewData["Title"] = "Onay Bekleyen Kargolar";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex flex-wrap gap-3 mb-4">
    <a href="~/CargoDetail/Index" class="btn rounded-pill fw-bold px-3 py-1 me-2 mb-2 shadow-sm" style="background-color: #f1f3f5; color: #495057;">Tümü (@ViewBag.AllCount)</a>
    <a href="~/CargoDetail/AwaitingApproval" class="btn rounded-pill fw-bold px-3 py-1 me-2 mb-2 shadow-sm" style="background-color: #fde2e1; color: #d62828; border: 1px solid #f5c2c0;">Onay Bekliyor (@ViewBag.PendingCount)</a>
    <a href="~/CargoDetail/ReadyForCargo" class="btn rounded-pill fw-bold px-3 py-1 me-2 mb-2 shadow-sm" style="background-color: #fff4cc; color: #e0a800; border: 1px solid #ffe69c;">Paketlendi (@ViewBag.PackagedCount)</a>
    <a href="~/CargoDetail/CargoInDelivery" class="btn rounded-pill fw-bold px-3 py-1 me-2 mb-2 shadow-sm" style="background-color: #d0ebff; color: #1971c2; border: 1px solid #a5d8ff;">Kargoda (@ViewBag.InCargoCount)</a>
    <a href="~/CargoDetail/Delivered" class="btn rounded-pill fw-bold px-3 py-1 me-2 mb-2 shadow-sm" style="background-color: #d3f9d8; color: #2b8a3e; border: 1px solid #b2f2bb;">Teslim Edildi (@ViewBag.DeliveredCount)</a>
    <a href="~/CargoDetail/Cancelled" class="btn rounded-pill fw-bold px-3 py-1 me-2 mb-2 shadow-sm" style="background-color: #ffe3e3; color: #c92a2a; border: 1px solid #ffc9c9;">İptal Edilenler (@ViewBag.CancelledCount)</a>
    <!-- YENİ STATÜ BUTONLARI -->
    <a href="/CargoDetail/OfficePickup" class="btn rounded-pill fw-bold px-3 py-1 me-2 mb-2 shadow-sm" style="background-color: #e0f7fa; color: #00838f; border: 1px solid #b2ebf2;">Ofisten Teslim (@ViewBag.OfficePickupCount)</a>
    <a href="/CargoDetail/ReturnWaiting" class="btn rounded-pill fw-bold px-3 py-1 me-2 mb-2 shadow-sm" style="background-color: #f4ecfb; color: #6f42c1; border: 1px solid #d6c3eb;">İade Geldiği Zaman Kargoya Verilecek (@ViewBag.ReturnWaitingCount)</a>
    <a href="~/CargoDetail/Deleted" class="btn rounded-pill fw-bold px-3 py-1 me-2 mb-2 shadow-sm" style="background-color: #e9ecef; color: #6c757d; border: 1px solid #dee2e6;">Silinenler (@ViewBag.DeletedCount)</a>
</div>

<div class="d-flex justify-content-between align-items-center mt-3 mb-2">
    <h4>Onay Bekleyen Kargolar</h4>
</div>
<hr />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<table id="DataTables" class="table table-hover align-middle mb-0" style="width:100%">
    <thead>
        <tr>
            <th>ID</th>
            <th>Durum</th>
            <th>Tarih</th>
            <th>Kullanıcı</th>
            <th>Depo</th>
            <th>Ürün (Kategori : Miktar)</th>
            <th>Lokasyon</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td><span class="badge bg-danger">@item.StatusName</span></td>
                <td>@(item.RequestFormRequestedDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                <td>@(item.RequestFormRequestedBy ?? "-")</td>
                <td>@item.MainRepoName</td>
                <td>
                    @foreach (var p in item.Products)
                    {
                        <div>@p.CategoryName : @p.Quantity Adet</div>
                    }
                </td>
                <td>
                    <div class="fw-bold">@item.HospitalName</div>
                    
                    @if (item.IsOfficeDelivery)
                    {
                        <span class="badge bg-soft-info text-info border border-info mt-1" style="font-size: 0.75rem;">
                            <i class="mdi mdi-office-building"></i> Ofisten Teslim
                        </span>
                    }

                    @if (item.IsShipAfterReturn)
                    {
                        <span class="badge bg-soft-warning text-warning border border-warning mt-1" style="font-size: 0.75rem;">
                            <i class="mdi mdi-keyboard-return"></i> İade Gelince Kargolanacak
                        </span>
                    }
                </td>
                <td>
                    <button type="button" class="btn btn-sm btn-primary change-status-btn"
                            data-bs-toggle="modal" data-bs-target="#cargoStatusModal"
                            data-cargodetailid="@item.Id"
                            data-location="@item.HospitalName"
                            data-category="@(item.Products.Any() ? string.Join(", ", item.Products.Select(p => p.CategoryName)) : "-")"
                            data-product="@(item.Products.Any() ? string.Join(", ", item.Products.Select(p => p.ProductName)) : "-")"
                            data-quantity="@(item.Products.Any() ? string.Join(", ", item.Products.Select(p => p.Quantity)) : "-")"
                            data-receiver="@item.ReceiverFullName"
                            data-address="@item.HospitalAddress"
                            data-label="@item.Label"
                            data-sendreason="@item.SendReason"
                            data-condition="@item.ProductCondition"
                            data-note="@item.Note"
                            data-serial="@item.SerialNumber"
                            data-ethmac="@item.EthMac"
                            data-wlanmac="@item.WlanMac"
                            data-connection="@item.ConnectionType"
                            data-configurl="@item.ConfigUrl">

                        <i class="mdi mdi-cog"></i> İşlem Yap
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Kargo Durumu Modal -->
<div class="modal fade" id="cargoStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <form asp-action="SaveCargoInfo" id="cargoOperasyonForm" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="cargoDetailId" />

                <div class="modal-header bg-light">
                    <h5 class="modal-title text-primary"><i class="mdi mdi-check-circle-outline"></i> Onay İşlem Merkezi</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="row">
                        <!-- Sol TARAF: DETAYLAR -->
                        <div class="col-lg-6 border-end pe-4">
                            <h6 class="text-uppercase text-muted mb-3 border-bottom pb-2">1. Gönderim Detayı</h6>
                            <table class="table table-sm table-borderless">
                                <tbody>
                                    <tr><td class="text-muted" style="width: 140px;">Lokasyon:</td><td class="fw-bold" id="summaryLocation">-</td></tr>
                                    <tr>
                                        <td class="text-muted">Ürün Adı:</td>
                                        <td class="fw-bold">
                                            <span id="summaryProduct">-</span>
                                            <a href="javascript:void(0);" id="arcBoxConfigIcon" class="text-warning ms-2 d-none"
                                                   data-bs-toggle="popover" data-bs-html="true" title="<i class='mdi mdi-router-wireless'></i> Arc Box Config İçeriği">
                                                <i class="mdi mdi-cog fs-5 spin-icon" title="Config Detayları"></i>
                                            </a>
                                        </td>
                                    </tr>
                                    <tr><td class="text-muted">Kategori:</td><td class="fw-bold" id="summaryCategory">-</td></tr>
                                    <tr><td class="text-muted">Adet:</td><td class="fw-bold" id="summaryQuantity">-</td></tr>
                                    
                                    <tr><td class="text-muted">Etiket:</td><td class="fw-bold" id="summaryLabel">-</td></tr>
                                    <tr><td class="text-muted">Gönd. Nedeni:</td><td class="fw-bold text-primary" id="summarySendReason">-</td></tr>
                                    <tr><td class="text-muted">Ürün Durumu:</td><td class="fw-bold text-info" id="summaryCondition">-</td></tr>
                                    <tr><td class="text-muted align-top">Not:</td><td class="fw-bold small fst-italic text-wrap" id="summaryNote">-</td></tr>
                                    
                                    <tr><td colspan="2"><hr class="my-1"></td></tr>
                                    <tr><td class="text-muted">Alıcı:</td><td class="fw-bold" id="summaryRecipient">-</td></tr>
                                    <tr><td class="text-muted">Adres:</td><td class="fw-bold small text-wrap" id="summaryAddress">-</td></tr>
                                </tbody>
                            </table>
                        </div>
                        <!-- SAĞ TARAF: AKSİYON -->
                        <div class="col-lg-6 ps-4">
                            <h6 class="text-uppercase text-muted mb-3 border-bottom pb-2">2. Karar</h6>
                            <div class="mb-3 bg-light p-2 rounded border">
                                <label class="form-label fw-bold text-dark mb-1"><i class="mdi mdi-account-hard-hat"></i> Kargo Hazırlayan <span class="text-danger">*</span></label>
                                <select name="CargoPreparerUserId" id="cargoPreparer" class="form-select border-secondary" asp-items="@(ViewBag.UserNames)">
                                    <option value="">-- Personel Seçiniz --</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                
                                <label class="form-label fw-bold">İşlem <span class="text-danger">*</span></label>
                                <select name="StatusId" id="cargoStatusSelect" class="form-select border-primary">
                                    <option value="">-- Seçiniz --</option>
                                    <option value="@((int)EnumStatusType.Paketlendi)">Onayla (Paketlendi)</option>
                                    <!-- YENİ EKLENEN PDF STATÜLERİ -->
                                    <option value="11">Ofisten Teslim Alınacak</option>
                                    <option value="13">İade Geldiği Zaman Kargolanacak</option>
                                    <!-- -------------------------- -->
                                    <option value="@((int)EnumStatusType.İptal)">Reddet (İptal Et)</option>
                                </select>
                            </div>
                            <div id="cancelReasonField" class="d-none mt-3">
                                <label class="form-label text-danger fw-bold">İptal Sebebi <span class="text-danger">*</span></label>
                                <textarea name="CancelDescription" id="cancelReason" class="form-control border-danger" rows="2"></textarea>
                            </div>
                            <div id="cargoActionFields" class="d-none mt-3 p-3 border rounded bg-soft-primary">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Kargo Firması</label>
                                    <select name="CargoNameId" class="form-select border-primary" asp-items="@ViewBag.CargoNames">
                                        <option value="">-- Firma Seçiniz --</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Takip Numarası</label>
                                    <input type="text" name="TrackingNumber" class="form-control border-primary" placeholder="Barkod No Giriniz">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="button" id="btnSaveCargo" class="btn btn-success px-5">Kaydet ve Güncelle</button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        // 1. STATÜ SABİTLERİ (C# Enum'dan alınıyor)
        const ST_IPTAL = @((int)EnumStatusType.İptal);
        const ST_PAKETLENDI = @((int)EnumStatusType.Paketlendi);
        const ST_KARGODA = @((int)EnumStatusType.Kargoda);
        const ST_OFISTEN_TESLIM = @((int)EnumStatusType.OfistenTeslimAlinacak); 
        const ST_IADE_KARGOLANACAK = @((int)EnumStatusType.IadeGeldigindeKargolanacak);

        // 2. STATÜ SEÇİM DEĞİŞİKLİĞİ EKRANI (Aç/Kapat)
        $("#cargoStatusSelect").on("change", function() {
            const st = parseInt($(this).val());

            // İptal seçilirse sebep alanını göster
            $("#cancelReasonField").toggleClass("d-none", st !== ST_IPTAL);
    
            // Sadece Paketlendi veya Kargoda seçilirse kargo firması/no alanını göster
            $("#cargoActionFields").toggleClass("d-none", st !== ST_PAKETLENDI && st !== ST_KARGODA);
        });

        // 3. KAYDET BUTONU DOĞRULAMA VE GÖNDERME
        $("#btnSaveCargo").on("click", function () {
            const st = parseInt($("#cargoStatusSelect").val());
            
            // Hata almamak için güvenli trim (boş gelirse JavaScript'i çökertmez)
            const reason = $("#cancelReason").val()?.trim() || ""; 
            const preparer = $("#cargoPreparer").val();

            if (!st) {
                Swal.fire('Hata', 'Lütfen bir işlem seçin.', 'warning');
                return;
            }
    
            // İŞTE SESSİZCE PATLAYAN YER BURASIYDI! (Değişken isimleri yukarıdakilerle birebir aynı yapıldı)
            if ((st === ST_PAKETLENDI || st === ST_OFISTEN_TESLIM || st === ST_IADE_KARGOLANACAK) && !preparer) {
                Swal.fire('Eksik Bilgi', 'Onaylama işlemi için Kargoyu Hazırlayan personeli seçmelisiniz.', 'warning');
                return;
            }

            if (st === ST_IPTAL && !reason) {
                Swal.fire('Hata', 'İptal sebebi girmelisiniz.', 'warning');
                return;
            }
            
            // Validation (doğrulama) engellerine takılmadan formu anında sunucuya zorla gönder!
            $("#cargoOperasyonForm")[0].submit();
        });

        // 4. MODAL AÇILIRKEN BİLGİLERİ DOLDURMA
        $(document).on("click", ".change-status-btn", function () {
            const d = $(this).data();

            // TEMEL BİLGİLER
            $("#cargoDetailId").val(d.cargodetailid || "");
            $("#summaryLocation").text(d.location || "-");
            $("#summaryCategory").text(d.category || "-");
            $("#summaryQuantity").text(d.quantity || "-");
            $("#summaryRecipient").text(d.receiver || "-");
            $("#summaryAddress").text(d.address || "-");
        
            // YENİ PDF BİLGİLERİ
            $("#summaryLabel").text(d.label || "-");
            $("#summarySendReason").text(d.sendreason || "-");
            $("#summaryCondition").text(d.condition || "-");
            $("#summaryNote").text(d.note || "-");

            let productName = d.product || "-";
            $("#summaryProduct").text(productName);

            // ARC BOX ZEKASI VE POPOVER (Baloncuk)
            let pNameClean = productName.replace(/[\s\-]+/g, '').toLowerCase();
            if (pNameClean.includes("arcbox")) {
                let configHtml = `
                    <ul class="list-unstyled small mb-0">
                        <li><b>Seri No:</b> ${d.serial || 'Bekleniyor...'}</li>
                        <li><b>ETH MAC:</b> ${d.ethmac || 'Yok'}</li>
                        <li><b>WLAN MAC:</b> ${d.wlanmac || 'Yok'}</li>
                        <li><b>Bağlantı:</b> ${d.connection || 'DHCP'}</li>
                        <li class="mt-1"><b>URL:</b> <a href="${d.configurl || '#'}" target="_blank" class="text-truncate d-inline-block" style="max-width: 150px;">${d.configurl || 'Oluşturulmadı'}</a></li>
                        <li class="text-muted mt-1">dhcpd.conf | wpa_supplicant.conf</li>
                    </ul>
                `;
            
                $("#arcBoxConfigIcon").attr("data-bs-content", configHtml).removeClass("d-none");
            
                // Popover'ı yenile
                $('[data-bs-toggle="popover"]').popover('dispose');
                $('[data-bs-toggle="popover"]').popover({ html: true });
            } else {
                $("#arcBoxConfigIcon").addClass("d-none");
            }

            // Formu Temizle
            $("#cargoStatusSelect").val("").trigger("change");
            $("#cargoPreparer").val("");
            $("#trackingNumber, #cargoCompany, #cancelReason").val("");
            if(typeof syncRequired === "function") syncRequired();
        });
    </script>
}