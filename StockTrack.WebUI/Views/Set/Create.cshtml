@model StockTrack.Dto.Set.SetCreateDto
@using StockTrack.Entity.Enitities
@{
    ViewData["Title"] = "Yeni Set Oluştur";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    // Controller'dan gelen tüm ürünler listesi (Artık SelectList değil, doğrudan nesne listesi geliyor)
    var allProducts = ViewBag.Products as List<Product>;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0 text-white"><i class="mdi mdi-plus-box me-2"></i> Yeni Set Tanımla</h5>
            </div>

            <div class="card-body p-4">
                <form asp-controller="Set" asp-action="Create" method="post">

                    <div class="row mb-4">
                        <div class="col-md-9">
                            <label class="form-label fw-bold">Set Adı <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="Name" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Durum</label>
                            <select class="form-select" name="IsActive">
                                <option value="true" selected>Aktif</option>
                                <option value="false">Pasif</option>
                            </select>
                        </div>
                    </div>

                    <hr class="text-muted opacity-25" />
                    <h6 class="text-muted mb-3"><i class="mdi mdi-link-variant"></i> Set İçeriği (Ürünler)</h6>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-secondary small">Bu sete dahil edilecek ürünleri seçin <span class="text-danger">*</span></label>
                        <select class="form-control select2-multiple" name="ProductIds" multiple="multiple" required>
                            @if (allProducts != null)
                            {
                                foreach (var p in allProducts)
                                {
                                    <option value="@p.Id">@p.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="d-flex justify-content-end mt-4">
                        <a href="~/Set/Index" class="btn btn-light border me-2 px-4">İptal</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="mdi mdi-content-save"></i> Seti Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function() {
            // Arayüzdeki çoklu seçim kutusunu modern Select2 yapısına çeviriyoruz
            $('.select2-multiple').select2({
                placeholder: "Ürün ara veya seç...",
                allowClear: true,
                width: '100%' // Kutunun form içine tam oturması için
            });
        });
    </script>
}